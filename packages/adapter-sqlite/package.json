{
  "name": "nestjs-ai-middleware-adapter-sqlite",
  "version": "0.3.2",
  "description": "Sqlite storage adapter for NestJS AI middleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smthspecial/nest-ai-middleware.git",
    "directory": "packages/adapter-sqlite"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "publish:npm": "npm publish --access=public --registry=https://registry.npmjs.org/",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "peerDependencies": {
    "nestjs-ai-middleware": "^0.3.2"
  },
  "devDependencies": {
    "nestjs-ai-middleware": "0.3.2"
  }
}
