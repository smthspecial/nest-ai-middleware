{
  "name": "nestjs-ai-middleware-adapter-postgres",
  "version": "0.3.1",
  "description": "Postgres storage adapter for NestJS AI middleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smthspecial/nest-ai-middleware.git",
    "directory": "packages/adapter-postgres"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "publish:npm": "npm publish --access=public --registry=https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "nestjs-ai-middleware": "^0.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nestjs-ai-middleware": "0.3.1"
  },
  "dependencies": {
    "@types/pg": "^8.23.1"
  }
}
