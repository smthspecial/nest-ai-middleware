{
  "name": "nestjs-ai-middleware",
  "version": "0.3.1",
  "description": "Provider-independent AI middleware for NestJS applications",
  "keywords": [
    "nestjs",
    "ai",
    "tool-calling",
    "sqlite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smthspecial/nest-ai-middleware.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills/nest-ai-middleware-integration/SKILL.md"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@types/json-schema": "^7.0.15",
    "ajv": "^8.20.0"
  }
}
