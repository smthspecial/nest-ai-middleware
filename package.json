    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "turbo": "^2.11.13",
    "@types/pg": "^8.23.1"
  }
