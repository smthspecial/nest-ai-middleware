{
  "name": "nest-ai-middleware-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^26.0.0"
  },
  "workspaces": [
    "packages/*"
