{
  "name": "nest-ai-middleware-workspace",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "pack:packages": "npm run build && npm pack --workspaces",
    "publish:npm": "npm publish --workspace=packages/core --workspace=packages/adapter-mongodb --workspace=packages/adapter-postgres --workspace=packages/adapter-sqlite --access=public --registry=https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "prettier": "3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
